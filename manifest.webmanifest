{
  "name": "Toddler Trials Pro",
  "short_name": "TTP",
  "description": "Complete baby & toddler tracking app \u2014 offline, private, yours forever. 43 trackers, photo gallery, vaccines, milestones, feeding timer, growth charts & more.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#1b2a63",
  "theme_color": "#1b2a63",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "health",
    "lifestyle",
    "medical"
  ],
  "iarc_rating_id": "",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Quick Log Feed",
      "short_name": "Feed",
      "description": "Log a feeding session",
      "url": "./"
    },
    {
      "name": "Add Milestone",
      "short_name": "Milestone",
      "description": "Record a milestone",
      "url": "./"
    },
    {
      "name": "Log Sleep",
      "short_name": "Sleep",
      "description": "Track sleep session",
      "url": "./"
    }
  ],
  "related_applications": [],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "id": "/",
  "display_override": [
    "standalone"
  ],
  "screenshots": [
    {
      "src": "screenshot-narrow.jpg",
      "sizes": "1290x2796",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Cards Dashboard view on mobile"
    },
    {
      "src": "screenshot-wide.jpg",
      "sizes": "1024x500",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Toddler Trials Pro on a wider screen"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [
          ".json"
        ]
      }
    }
  ]
}